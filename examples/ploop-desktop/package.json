{
  "name": "@example/ploop-desktop",
  "version": "0.1.1",
  "private": true,
  "description": "The ploop desktop app for macOS: ploop's chat plus a credential vault it can sign in with.",
  "author": "ploop",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "pnpm build && node node_modules/electron/install.js && electron .",
    "dist": "pnpm build && node scripts/prepare-next.mjs && electron-builder --mac",
    "prepare:next": "node scripts/prepare-next.mjs",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@ai-sdk/provider-utils": "workspace:*",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.19.19",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.9",
    "esbuild": "^0.28.2",
    "jsdom": "^24.1.3",
    "typescript": "6.0.3",
    "zod": "3.25.76"
  }
}
