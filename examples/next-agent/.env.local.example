# Required: the model runs through OpenRouter.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Web search (searchWeb tool). Get a key at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Sending email (sendEmail tool). Get a key at https://resend.com and use a
# sender address on a domain you've verified there.
RESEND_API_KEY=your_resend_api_key_here
PLOOP_FROM_EMAIL=ploop@yourdomain.com

# Optional: signs approval requests so a browser can't forge an approval.
# Any long random string, e.g. the output of `openssl rand -hex 32`.
PLOOP_APPROVAL_SECRET=

# Optional: where memory and plans are stored (defaults to ./.ploop).
# PLOOP_DATA_DIR=/tmp/ploop

# Ploop's VM. `vercel link && vercel env pull` adds VERCEL_OIDC_TOKEN, which
# gives ploop a persistent Vercel Sandbox VM. Without it, ploop uses an
# in-memory sandbox. Set PLOOP_VM=local or PLOOP_VM=vercel to force either.
# VERCEL_OIDC_TOKEN=
# PLOOP_VM_NAME=ploop-vm
